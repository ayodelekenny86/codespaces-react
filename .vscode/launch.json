{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Run application",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run-script",
        "start"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "java",
      "name": "Launch Java Program with .env",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "com.mySample.App",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}