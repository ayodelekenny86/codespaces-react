# MongoDB Connection (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aqualink

# JWT Secret (Required)
JWT_SECRET=aqualink-secret-key-2024-change-in-production

# Environment
NODE_ENV=production

# CORS - Your Frontend URL (Required for production)
FRONTEND_URL=https://your-app.vercel.app

# Server Port
PORT=4000
